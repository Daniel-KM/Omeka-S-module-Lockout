msgstr "Продължителност на блокирането (секунди)"

#: src/Form/ConfigForm.php:70
msgid "Allowed lockouts before long lockout"
msgstr "Разрешени блокирания преди дълго блокиране"

#: src/Form/ConfigForm.php:78
msgid "Long lock out (seconds)"
msgstr "Дълго блокиране (секунди)"

#: src/Form/ConfigForm.php:86
msgid "Valid duration (seconds)"
msgstr "Срок на валидност (секунди)"

#: src/Form/ConfigForm.php:94
